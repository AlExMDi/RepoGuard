{
  "permissions": {
    "allow": [
      "Bash(pnpm test *)", "Bash(pnpm test)", "Bash(pnpm typecheck)", "Bash(pnpm lint)",
      "Bash(git status)", "Bash(git diff *)", "Bash(git log *)",
      "Bash(gh issue view *)", "Bash(gh pr view *)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.*)",
      "Bash(git push --force *)", "Bash(git push origin main)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-secrets.sh", "args": [] }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format.sh", "args": [] }]
      }
    ]
  }
}
